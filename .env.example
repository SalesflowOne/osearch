# --- Self-host (default) ---
# Leave OWeb vars unset to keep local SQLite + setup wizard.

# --- OWeb constellation mode ---
# When NEXT_PUBLIC_SUPABASE_URL + anon/publishable key are set, OSearch
# requires OWeb sign-in, workspace selection, entitlements, and OneCredits.
OSEARCH_OWEB_MODE=true
NEXT_PUBLIC_SUPABASE_URL=https://ebjzdcnphkfpxfldnatm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional modern publishable key (same project)
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only — debit OneCredits + optional admin reads
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_OWEB_APP_URL=https://oweb.one
OSEARCH_GUEST_MAX_SEARCHES=5

# Existing AI / search env (unchanged)
# AI_GATEWAY_API_KEY=
# VERCEL_AI_GATEWAY_ENABLED=true
# SEARXNG_API_URL=
